/sourcecodepro-italic.ttf","site-lib/fonts/sourcecodepro-bold.ttf","site-lib/fonts/sourcecodepro-bolditalic.ttf","site-lib/fonts/flow-circular.woff2","site-lib/fonts/intervariable.woff2","site-lib/fonts/intervariable-italic.woff2","site-lib/media/external-link.svg","site-lib/media/external-link-rtl.svg","site-lib/html/file-tree-content.html","site-lib/scripts/webpage.js","site-lib/scripts/graph-wasm.js","site-lib/scripts/graph-render-worker.js","site-lib/media/favicon.png","site-lib/styles/obsidian.css","site-lib/styles/global-variable-styles.css","site-lib/styles/main-styles.css"],"webpages":{"characters/npcs/golenthi-senka-(dead).html":{"title":"Golenthi Senka (Dead)","icon":"","description":"The previous Lightbearer from Stonetop.\nShe travelled to Marshedge to do battle with a <a data-tooltip-position=\"top\" aria-label=\"The River King\" data-href=\"The River King\" href=\"things/the-river-king.html\" class=\"internal-link\" target=\"_self\" rel=\"noopener nofollow\">demon of the river</a>.\nDied fighting the demon 31 years ago.\nRemembered as a martyr by her followers.<br>Mother to <a data-href=\"Aurelia Senka - The Lightbearer\" href=\"characters/aurelia-senka-the-lightbearer.html\" class=\"internal-link\" target=\"_self\" rel=\"noopener nofollow\">Aurelia Senka - The Lightbearer</a>, by an unknown father","aliases":[],"inlineTags":[],"frontmatterTags":[],"headers":[{"heading":"Relations","level":2,"id":"Relations_0"}],"links":["things/the-river-king.html","characters/aurelia-senka-the-lightbearer.html"],"author":"","coverImageURL":"","fullURL":"characters/npcs/golenthi-senka-(dead).html","pathToRoot":"../..","attachments":[],"createdTime":1794267975812,"modifiedTime":1794268274668,"sourceSize":289,"sourcePath":"Characters/NPCs/Golenthi Senka (Dead).md","exportPath":"characters/npcs/golenthi-senka-(dead).html","showInTree":true,"treeOrder":2,"backlinks":["characters/aurelia-senka-the-lightbearer.html"],"type":"markdown"},"characters/npcs/judicious-ackord.html